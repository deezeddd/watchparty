{
  "manifest_version": 3,
  "name": "WatchParty",
  "version": "0.1.0",
  "description": "Watch together: synchronized playback, chat, and video calls on YouTube, Netflix, Hotstar, JioCinema, and any site with a video player.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WatchParty"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["content/netflix-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidebar/sidebar.html", "sidebar/sidebar.css", "sidebar/sidebar.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
